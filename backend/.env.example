# Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pawmart_db?schema=public

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Client URL (Frontend CORS)
CLIENT_URL=http://localhost:5173

# Email Service (Brevo API)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=PawMart
BREVO_SENDER_EMAIL=noreply@pawmart.com

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
